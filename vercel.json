{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api"
    },
    {
      "source": "/api/anime",
      "destination": "/api"
    },
    {
      "source": "/api/anime/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/episodes/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/jikan/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
